# Copy this file to agent/.env on the computer connected to the thermal printer.
DOGCHEF_API_URL=https://seu-dominio.vercel.app
PRINT_AGENT_TOKEN=use-o-mesmo-token-configurado-na-Vercel
PRINT_AGENT_ID=cozinha-1

# Network printer / Ethernet (recommended)
PRINTER_TRANSPORT=tcp
PRINTER_HOST=192.168.0.50
PRINTER_PORT=9100

# Or a Windows shared USB printer. Do not set PRINTER_HOST in this mode.
# PRINTER_TRANSPORT=windows-share
# PRINTER_SHARE=\\SERVIDOR\\NOME_DA_IMPRESSORA
