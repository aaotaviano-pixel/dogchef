# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_SESSION_SECRET=gere-uma-chave-aleatoria-de-no-minimo-32-caracteres
CUSTOMER_SESSION_SECRET=gere-outra-chave-aleatoria-de-no-minimo-32-caracteres

# Supabase database and Google login
# The secret key is server-side only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_substitua
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua

# Mercado Pago Pix
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-access-token
MERCADO_PAGO_WEBHOOK_SECRET=defina-um-segredo-para-validar-webhooks

# WhatsApp support link only; no automatic order messages
# Use country code and digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Google Maps (optional; without a key, registered neighborhoods are used)
GOOGLE_MAPS_API_KEY=sua-chave-google-maps

# Local print agent
DOGCHEF_API_URL=https://seu-dominio.vercel.app
PRINT_AGENT_TOKEN=gere-um-token-longo-e-aleatorio
PRINTER_TRANSPORT=tcp
PRINTER_HOST=192.168.0.50
PRINTER_PORT=9100
# USB/Windows sharing: \\SERVIDOR\\NOME_DA_IMPRESSORA
PRINTER_SHARE=\\SERVIDOR\\NOME_DA_IMPRESSORA
